[Unit]
Description=PlopDock React Dashboard
Documentation=https://github.com/your-org/plopdock
After=network.target plopdock-api-bridge.service
Wants=network.target
Requires=plopdock-api-bridge.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/mnt/c/Code/plopdock/dashboard
Environment=NODE_ENV=production
Environment=FORCE_COLOR=1
Environment=HOST=0.0.0.0
Environment=PORT=5173
Environment=PATH=/home/dougw/.nvm/versions/node/v22.16.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/npm run dev
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/mnt/c/Code/plopdock
PrivateTmp=true

[Install]
WantedBy=multi-user.target